# Copy to .env and edit. docker compose reads .env automatically.

# Address other machines use to reach Kafka. Keep "localhost" when the bridge
# runs on the same computer as Docker; set the ground-station IP (e.g. 192.168.1.10)
# when the bridge or tools run on another machine.
KAFKA_ADVERTISED_HOST=localhost

# = maximum number of drones (10, decided in Phase A / A3). Set BEFORE the first
# `docker compose up`: adding partitions later reshuffles drone_id keys.
KAFKA_PARTITIONS=10

# Host ports (change if something on Windows already uses them: netstat -ano | findstr ":5433 :8081")
DB_HOST_PORT=5433
KAFKA_UI_PORT=8081

POSTGRES_DB=aquarius
POSTGRES_USER=aquarius
POSTGRES_PASSWORD=aquarius
GRAFANA_ADMIN_PASSWORD=aquarius

# C5: two detections closer than this (metres) are merged into one person pin
MERGE_RADIUS_M=3.0
