      "title": "ความหน่วงโดรน → ฐานข้อมูล",
      "description": "received_at − ts ของ telemetry ทุก 10 วินาที · เชื่อได้เมื่อนาฬิกาตรงกัน (โดรนจริง + chrony หรือ Gazebo ที่ RTF ≈ 1)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aquarius-tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT $__timeGroupAlias(received_at, '10s'),\n       percentile_cont(0.5)  WITHIN GROUP (ORDER BY extract(epoch FROM received_at - ts) * 1000) AS \"p50\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM received_at - ts) * 1000) AS \"p95\"\n  FROM telemetry WHERE mission_id = '$mission' AND $__timeFilter(received_at)\n GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
