  "templating": {
    "list": [
      {
        "name": "mission",
        "label": "ภารกิจ",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "aquarius-tsdb"
        },
        "query": "SELECT mission_id::text AS __value, coalesce(name, left(mission_id::text, 8)) || ' · ' || coalesce(to_char(last_ts AT TIME ZONE 'Asia/Bangkok', 'DD Mon HH24:MI'), 'no data') AS __text FROM missions ORDER BY last_ts DESC NULLS LAST LIMIT 50",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "swath",
        "label": "ความกว้างกล้อง (m)",
        "type": "custom",
        "query": "0,30,70",
        "current": {
          "text": "70",
          "value": "70"
        },
        "options": [],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "description": "0 = นับช่องที่เส้นบินผ่าน (C4) · 70 = ภาพกว้างจริงที่ความสูง 30 m (HFOV 100°)"
      },
      {
        "name": "stream_url",
        "label": "ที่อยู่กล้อง",
        "type": "textbox",
        "query": "http://localhost:8090",
        "current": {
          "text": "http://localhost:8090",
          "value": "http://localhost:8090"
        },
        "options": [],
        "hide": 0,
        "description": "เครื่องอื่นให้ใส่ IP ของ ground station เช่น http://192.168.1.10:8090"
      }
