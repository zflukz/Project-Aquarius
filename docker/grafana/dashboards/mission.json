    {
      "id": 8,
      "type": "geomap",
      "title": "แผนที่ภารกิจ",
      "description": "กริดเปลี่ยนเป็นสีเขียวเมื่อแนวบินจริงผ่าน (D2) · จุดเทา = แนวบินตามแผน mCPP · สามเหลี่ยมแดง = หมุดผู้ประสบภัย ตัวเลข = จำนวนครั้งที่ตรวจพบ · วงกลมฟ้า = ตำแหน่งจริง (demo/F3)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aquarius-tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 14,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT lat, lon, CASE WHEN covered THEN 1 ELSE 0 END AS covered, cell_row AS \"แถว\", cell_col AS \"คอลัมน์\"\n  FROM aq_cell_coverage(aq_current_area('$mission'), $swath)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT ST_Y(p.geom) AS lat, ST_X(p.geom) AS lon, fp.drone_id\n  FROM flight_paths fp,\n       LATERAL ST_DumpPoints(ST_Segmentize(fp.geom::geography, 10)::geometry) p\n WHERE fp.mission_id = '$mission' AND fp.kind = 'planned'\n   AND fp.version = (SELECT max(version) FROM flight_paths q\n                      WHERE q.mission_id = fp.mission_id AND q.drone_id = fp.drone_id AND q.kind = 'planned')"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (drone_id, time_bucket('2 seconds', ts)) lat, lon, drone_id\n  FROM telemetry\n WHERE mission_id = '$mission' AND $__timeFilter(ts) AND (alt_rel IS NULL OR alt_rel >= 2)\n ORDER BY drone_id, time_bucket('2 seconds', ts), ts"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT drone_id, lat, lon, round(battery_pct) AS \"แบต %\", nav_state AS \"โหมด\"\n  FROM aq_drone_status('$mission', interval '1 hour')"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT lat, lon, n_detections AS \"ตรวจพบ\", round(max_conf::numeric, 2) AS \"มั่นใจ\", status\n  FROM survivor_pins WHERE mission_id = '$mission' AND status <> 'rejected'"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT lat, lon, label FROM ground_truth_persons WHERE mission_id = '$mission'"
        }
      ],
