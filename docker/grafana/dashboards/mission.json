            "type": "grafana-postgresql-datasource",
            "uid": "aquarius-tsdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT c.coverage_pct\n  FROM search_area a, aq_coverage(a.area_id, 'flown', $swath) c\n WHERE a.area_id = aq_current_area('$mission')"
        }
      ],
