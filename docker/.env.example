# Copy to docker/.env (or next to compose.server.yml on the VM) and edit.
# Read by docker compose for variable substitution.

# --- Images (all machines) ---
# where images are pushed (local) and pulled (VM / control computer)
REGISTRY=ghcr.io/zflukz
TAG=latest
# build only (local): PX4 commit for the telemetry image's px4_msgs = px4-sim's PX4
#   docker run --rm --entrypoint git ghcr.io/zflukz/aquarius-px4-sim -C /px4 rev-parse HEAD
#PX4_REF=main

# --- VM server (compose.server.yml) ---
# IP of the control computer that runs drone-control / QGroundControl
CONTROL_HOST=192.168.1.50

# --- Simulation (compose.server.yml and compose.local.yml) ---
# number of PX4 SITL drones in one Gazebo world (max 10 with the default port ranges)
PX4_NUM_DRONES=1
# Gazebo world: baylands (3D terrain, heavy) or default (flat, light)
PX4_GZ_WORLD=baylands
# vehicle: gz_x500 (4001, no camera) / gz_x500_mono_cam_down (4014, camera looking down)
#          gz_x500_mono_cam (4010, forward) / gz_x500_gimbal (4019) / gz_x500_depth (4002)
PX4_SIM_MODEL=gz_x500
PX4_SYS_AUTOSTART=4001
# metres between spawned drones (along y)
DRONE_SPACING=3
# 1 = no Gazebo GUI (much less CPU on a VM without GPU)
HEADLESS=
# 1 = QGroundControl on its own screen -> second noVNC :8082 (auto-connects to all drones), 0 = off
QGC=1
# virtual screen seen in noVNC
SCREEN_SIZE=1920x1080x24
# Gazebo camera follows this drone (0 = drone0), so Gazebo moves like the QGC map; empty = free camera
GZ_FOLLOW=0
# camera models: RTP/H.264 video to this IP, udp 5600+i (127.0.0.1 = QGC inside px4-sim; or the control computer IP)
PX4_VIDEO_HOST_IP=127.0.0.1
# camera models: image size / Hz. No GPU -> Gazebo renders on the CPU and waits for every frame:
# model default 1280x960 @ 30 Hz gave RTF 0.03 (sim 35x slower), 640x480 @ 10 Hz -> RTF 1.0. Empty = model default
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_RATE=10

# --- Telemetry + camera view (service telemetry, compose.server.yml and compose.local.yml) ---
# must be the same for px4-sim and telemetry
GZ_PARTITION=aquarius
ROS_DOMAIN_ID=0
# camera sensor "<link>/<sensor>" — empty = derived from PX4_SIM_MODEL, none = no camera bridge
GZ_CAMERA=
# camera in the browser http://<host>:8083/ , all topics in Foxglove ws://<host>:8765 (empty = off)
WEB_VIDEO_PORT=8083
FOXGLOVE_PORT=8765
# 1 = record a ros2 bag (mcap) to docker/data/bags (VM: ~/aquarius/data/bags) while the container runs
RECORD=
#RECORD_REGEX=.*/fmu/out/.*|/uav_[0-9]+/gz/.*|/uav_[0-9]+/camera/image_raw
# true pose per drone /uav_i/gz/ground_truth, Hz (empty = off)
GT_RATE=30

# --- Control (compose.control.yml and compose.local.yml) ---
# default drone the scripts connect to (udp 14540 + DRONE_ID)
DRONE_ID=0

# --- MCPP coverage flight (Drone-Control/mcpp_mission.py) ---
# run automatically when drone-control starts (empty = only by hand with `exec`)
#AUTO_RUN=python3 mcpp_mission.py
AUTO_RUN=
# drones flown together (drone i on udp 14540+i) — usually = PX4_NUM_DRONES
NUM_DRONES=1
# area (metres) centred on drone 0's home, line spacing, altitude, speed
AREA_W=80
AREA_H=60
SWEEP=5
ALT=20
SPEED=5
